# Local PostgreSQL
POSTGRES_DB=reconriver
POSTGRES_USER=reconriver
POSTGRES_PASSWORD=reconriver_local_only

# Spring Boot API
SPRING_PROFILES_ACTIVE=local
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/reconriver
DB_USERNAME=reconriver
DB_PASSWORD=reconriver_local_only
ALLOWED_ORIGINS=http://localhost:3000
DEMO_TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters
DEMO_SESSION_TTL_HOURS=24
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=25000
MAX_IMPORT_COLUMNS=20
MAX_IMPORT_ROW_CHARACTERS=16384
BATCH_CHUNK_SIZE=500
DB_POOL_SIZE=3
REQUESTS_PER_MINUTE=120
SESSION_CREATIONS_PER_MINUTE=10
UPLOADS_PER_HOUR=12
SCENARIO_LOADS_PER_HOUR=4
PROCESSOR_FEE_PERCENT=2.90
PROCESSOR_FEE_FIXED=0.30
SETTLEMENT_WINDOW_DAYS=3
LOG_LEVEL=INFO

# Production overrides use a direct Neon JDBC endpoint ending in
# ?sslmode=require and ALLOWED_ORIGINS=https://reconriver.vercel.app.

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GITHUB_URL=https://github.com/heybadrinath/reconriver
NEXT_PUBLIC_DATASET_URL=https://huggingface.co/datasets/heybadrinath/reconriver-synthetic-reconciliation
NEXT_PUBLIC_PORTFOLIO_URL=https://ram-badrinath.vercel.app/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/ram-badrinath-reddy-334856289/
